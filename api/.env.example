# Login DB anggota peran eap_app (API melakukan SET LOCAL ROLE eap_app per transaksi). Docker: eap_api@localhost:5433/kalla_eap
DATABASE_URL=postgresql://eap_api@localhost:5433/kalla_eap
PORT=3100

# Auth: produksi wajib OIDC (Keycloak, realm keis, klien bearer-only eap-api). HS256 hanya dev/uji dan ditolak saat NODE_ENV=production (D-13).
OIDC_JWKS_URI=http://localhost:8180/realms/keis/protocol/openid-connect/certs
OIDC_ISSUER=http://localhost:8180/realms/keis
OIDC_AUDIENCE=eap-api
#JWT_HS_SECRET=ganti-dengan-rahasia-dev-panjang

# Pengembangan lokal: CORS untuk SPA EAP
#CORS_ORIGINS=http://localhost:8766

# GSE eksekutor saga (mode live, opsional): alamat layanan per kode `service` langkah — hanya dari env (bukan dari klien/DB).
# POST <url>/<aksi> dengan Idempotency-Key; tanpa konfigurasi run live ditolak 503 (mode simulate tetap jalan).
#SAGA_SVC_FLOW=http://flow-api:8080/saga
#SAGA_SVC_FLOW_TOKEN=
#SAGA_TIMEOUT_MS=10000

# EIO mediasi (mode live, opsional): alamat target per kode KONEKTOR rute — hanya dari env (bukan dari klien/DB).
# Tanpa konfigurasi panggilan live ke rute itu 503 (mode simulate tetap jalan). Kill-switch CONSOLE: eio-mediation.
#EIO_SVC_FIA_AR=http://fia-api:8080/api
#EIO_SVC_FIA_AR_TOKEN=
#EIO_TIMEOUT_MS=10000
