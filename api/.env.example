# Login DB anggota peran eap_app (API melakukan SET LOCAL ROLE eap_app per transaksi). Docker: eap_api@localhost:5433/kalla_eap
DATABASE_URL=postgresql://eap_api@localhost:5433/kalla_eap
PORT=3100

# Auth: produksi wajib OIDC (Keycloak, realm keis, klien bearer-only eap-api). HS256 hanya dev/uji dan ditolak saat NODE_ENV=production (D-13).
OIDC_JWKS_URI=http://localhost:8180/realms/keis/protocol/openid-connect/certs
OIDC_ISSUER=http://localhost:8180/realms/keis
OIDC_AUDIENCE=eap-api
#JWT_HS_SECRET=ganti-dengan-rahasia-dev-panjang

# Pengembangan lokal: CORS untuk SPA EAP
#CORS_ORIGINS=http://localhost:8766
