{
  "name": "eap-api",
  "version": "1.0.0",
  "private": true,
  "description": "SAORAJA EAP API (NestJS) — kontrak SRS §6.2",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"const f=require('fs');f.cpSync('src/eaw/xsd','dist/eaw/xsd',{recursive:true});f.cpSync('src/req/policy','dist/req/policy',{recursive:true})\"",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "migrate": "ts-node src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:llm-live": "jest --runInBand test/llm-live"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.2.10",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation-fastify": "^0.56.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "re2js": "2.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xmllint-wasm": "5.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/.*[.]e2e[.]ts$",
    "transform": {
      "^.+[.]ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
